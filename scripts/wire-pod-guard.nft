#!/usr/sbin/nft -f
# Loaded by scripts/load-guard.sh (the pinned commit's copy) for wire-pod + myvector-tts; an nft error stops the service. :80/:8080 serve the same
# unauthenticated API (LLM key included), :8091 the TTS service, :443/:8084 chipper (STT, jdocs, SDK), :8093 the robot mic stream (raw PCM, no token): only this PC and the allowed*/tailnet* sets reach them. Add a device, then commit + `make server-pin`:
# LAN devices -> allowed4/6; Tailscale devices -> tailnet4/6 (tailscale0 only; re-check `tailscale status` after a device re-auths — its address can change).
# Never `tailscale serve`/`funnel` these ports: that proxy connects via lo and so bypasses every address check.
# The ports are hardcoded in `guarded`: a WEBSERVER_PORT override in source.sh needs the same change here.
table inet wirepod_guard
delete table inet wirepod_guard
define guarded = { 80, 8080, 8091, 443, 8084, 8093 }
table inet wirepod_guard {
	# Vector is on tailnet4 (robot-tailscale D11); a BLE re-setup after a factory reset re-adds its LAN IP here (:8080 first-time setup)
	set allowed4 {
		type ipv4_addr; flags interval
	}
	set allowed6 {
		type ipv6_addr; flags interval
	}
	# Own devices over Tailscale (phone: S24 FE; Vector), matched with iifname tailscale0 so a LAN host can't pose as a 100.x address
	set tailnet4 {
		type ipv4_addr; flags interval
		elements = { 192.0.2.53, 192.0.2.112 }
	}
	set tailnet6 {
		type ipv6_addr; flags interval
		elements = { 2001:db8::1, 2001:db8::2 }
	}
	chain input {
		type filter hook input priority filter; policy accept;
		# lo = WSL itself; loopback0 = Windows localhost under mirrored networking
		tcp dport $guarded iifname { "lo", "loopback0" } accept
		tcp dport $guarded ip saddr @allowed4 accept
		tcp dport $guarded ip6 saddr @allowed6 accept
		tcp dport $guarded iifname "tailscale0" ip saddr @tailnet4 accept
		tcp dport $guarded iifname "tailscale0" ip6 saddr @tailnet6 accept
		tcp dport $guarded limit rate 6/minute log prefix "wirepod-guard drop: "
		tcp dport $guarded drop
	}
}
