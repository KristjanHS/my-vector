#!/usr/sbin/nft -f
# Loaded by wire-pod.service (ExecStartPre; an nft error stops the whole service). :80 and :8080 serve the same
# unauthenticated API (LLM key included): only this PC and `allowed` reach them. Add a device here, then `make daemon-enable`.
# The ports are hardcoded: a WEBSERVER_PORT override in source.sh needs the same change here.
table inet wirepod_guard
delete table inet wirepod_guard
table inet wirepod_guard {
	# Vector (needs :80/ok for its connection check, :8080 for first-time BLE setup) — keep its DHCP lease reserved
	set allowed4 {
		type ipv4_addr; flags interval
		elements = { 192.0.2.76 }
	}
	set allowed6 {
		type ipv6_addr; flags interval
	}
	chain input {
		type filter hook input priority filter; policy accept;
		# lo = WSL itself; loopback0 = Windows localhost under mirrored networking
		tcp dport { 80, 8080 } iifname { "lo", "loopback0" } accept
		tcp dport { 80, 8080 } ip saddr @allowed4 accept
		tcp dport { 80, 8080 } ip6 saddr @allowed6 accept
		tcp dport { 80, 8080 } limit rate 6/minute log prefix "wirepod-guard drop: "
		tcp dport { 80, 8080 } drop
	}
}
