#!/usr/sbin/nft -f
# Loaded by wire-pod.service (ExecStartPre): :8080 answers only this PC and the `allowed` sets.
# Add a device: put its address in a set below, then `make daemon-enable`. Dropped callers log "wirepod-guard drop".
table inet wirepod_guard
delete table inet wirepod_guard
table inet wirepod_guard {
	set allowed4 {
		type ipv4_addr; flags interval
		elements = { 127.0.0.0/8 }
	}
	set allowed6 {
		type ipv6_addr; flags interval
		elements = { ::1 }
	}
	chain input {
		type filter hook input priority filter; policy accept;
		# lo = WSL itself; loopback0 = Windows localhost under mirrored networking
		tcp dport 8080 iifname { "lo", "loopback0" } accept
		tcp dport 8080 ip saddr @allowed4 accept
		tcp dport 8080 ip6 saddr @allowed6 accept
		tcp dport 8080 limit rate 6/minute log prefix "wirepod-guard drop: "
		tcp dport 8080 drop
	}
}
