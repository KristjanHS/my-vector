# Template: `make daemon-enable` replaces @REPO@ and installs it as /etc/systemd/system/wire-pod.service.
[Unit]
Description=wire-pod server (my-vector fork)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@REPO@
# run-server.sh loads the firewall and builds + runs the commit pinned in robot/work/server-sha (make ship writes it).
ExecStart=@REPO@/scripts/run-server.sh
Environment=HOME=/root GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0=@REPO@
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
