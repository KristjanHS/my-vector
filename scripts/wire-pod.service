# Template: `make daemon-enable` replaces @REPO@/@USER@ and installs it as /etc/systemd/system/wire-pod.service.
[Unit]
Description=wire-pod server (my-vector fork)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
# Runs as you; the one capability lets it bind :443/:80. `+` runs only the firewall load as root.
User=@USER@
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Nothing it launches may sudo back to root (e.g. via the start.sh NOPASSWD rule).
NoNewPrivileges=yes
WorkingDirectory=@REPO@
ExecStartPre=+@REPO@/scripts/load-guard.sh
# run-server.sh builds + runs the commit pinned in robot/work/server-sha (make ship writes it).
ExecStart=@REPO@/scripts/run-server.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
