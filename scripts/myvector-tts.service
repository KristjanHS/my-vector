# Template: `make tts-enable` fills the REPO/WORK/USER/HF_HOME/HF_HUB_CACHE @-placeholders and installs it as /etc/systemd/system/myvector-tts.service.
[Unit]
Description=my-vector TTS service (cori + af_bella -> 16 kHz PCM on :8091)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@
ExecStartPre=+/usr/sbin/nft -f @REPO@/scripts/wire-pod-guard.nft
ExecStart=@WORK@/tts/venv/bin/python -I @REPO@/tts/server.py
Environment=HF_HOME=@HF_HOME@ HF_HUB_CACHE=@HF_HUB_CACHE@ HF_HUB_OFFLINE=1 TTS_PIPER_DIR=@WORK@/voice-samples/piper-voices
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
