# Copy to robot/robot.env (gitignored) and fill in; ROBOT_KEY is relative to robot/. A key set here overrides the settings layers (LAN bootstrap via ROBOT_ENV).
# ROBOT_ESN, ROBOT_IP, ROBOT_LAN_IP, ROBOT_SERVER live in the overlay layer, $MY_VECTOR_OVERLAY_DIR/settings.env (ESN + IP: robot/backup/robot-id-*.txt); PC keys in ../dotfiles/shared-settings/settings.env.
# Root SSH key (robot/sshkey/keygen.sh makes it; robot/sshkey/apply.sh installs it on the robot).
ROBOT_KEY=../secrets/myvector_ed25519
# The image's public victor-dev key, used only to bootstrap after a reflash (this is the default).
#ROBOT_KEY_OLD=work/wire-os-victor/robot_sshkey
