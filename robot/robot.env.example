# Copy to robot/robot.env (gitignored) and fill in; ESN + IP are in robot/backup/robot-id-*.txt. ROBOT_KEY is relative to robot/.
ROBOT_ESN=00000000
ROBOT_IP=192.168.1.2
# Root SSH key (robot/sshkey/keygen.sh makes it; robot/sshkey/apply.sh installs it on the robot).
ROBOT_KEY=../secrets/myvector_ed25519
# The image's public victor-dev key, used only to bootstrap after a reflash (this is the default).
#ROBOT_KEY_OLD=work/wire-os-victor/robot_sshkey
ROBOT_SERVER=http://localhost:8080
# PC TTS service the robot fetches T2 speech from (plan R18): your PC's LAN IP, port 8091. Only voice-push.sh needs it.
ROBOT_TTS_URL=http://192.168.1.10:8091
