From: Kristjan Sillmann <kristjan.h.s@gmail.com>
Date: Fri, 6 Nov 2026 20:22:56 +0200
Subject: [PATCH] night-window

Good-night window 21:00-09:00 robot local time (SleepTracker night/morning console vars; morning default 7 -> 9).
Inside it: light sleep turns deep (no sound or lights-on wake, no ReactToSoundAsleep); idle-awake with no pending
intent goes straight back to deep sleep without a get-in anim (SleepReason NightWindow); person checks wait for
morning and are kept 15 min out, so he wakes soon after 09:00. Voice (trigger word), timers, SDK, touch and pick-up
still wake him. Kill switch: console var kSleepCycle_NightWindow (resets on engine restart; morning hour stays 9).
Logs my-vector.NightWindow.
Nap: console var kSleepCycle_NapUntil_s (epoch s, 0 = off; set by wire-pod's shut-up lock) counts as night until
then; one more than 4 h ahead (a ms epoch, garbage) is refused. Logs my-vector.NightWindow nap until / nap refused.
---
 .../behaviorComponent/sleepingTypes.clad      |  3 +
 .../behaviors/sleeping/behaviorSleepCycle.cpp | 81 ++++++++++++++++++-
 .../behaviorComponent/sleepTracker.cpp        |  3 +-
 3 files changed, 84 insertions(+), 3 deletions(-)

diff --git a/clad/src/clad/types/behaviorComponent/sleepingTypes.clad b/clad/src/clad/types/behaviorComponent/sleepingTypes.clad
index f641e04e..18575392 100644
--- a/clad/src/clad/types/behaviorComponent/sleepingTypes.clad
+++ b/clad/src/clad/types/behaviorComponent/sleepingTypes.clad
@@ -102,6 +102,9 @@ enum uint_8 SleepReason {
   Emergency,
 
   NightTimeReboot,
+
+  // my-vector: awake (or in light sleep) inside the SleepTracker night window
+  NightWindow,
 }
 
 enum uint_8 SleepReactionType {
diff --git a/engine/aiComponent/behaviorComponent/behaviors/sleeping/behaviorSleepCycle.cpp b/engine/aiComponent/behaviorComponent/behaviors/sleeping/behaviorSleepCycle.cpp
index cad706ae..69520a4a 100644
--- a/engine/aiComponent/behaviorComponent/behaviors/sleeping/behaviorSleepCycle.cpp
+++ b/engine/aiComponent/behaviorComponent/behaviors/sleeping/behaviorSleepCycle.cpp
@@ -42,6 +42,17 @@
 #include "webServerProcess/src/webService.h"
 #include "webServerProcess/src/webVizSender.h"
 
+// my-vector nap: wire-pod's shut-up lock sets kSleepCycle_NapUntil_s (epoch s) and the night rules hold until then
+#include <ctime>
+namespace { // my-vector nap
+// A nap longer than this is refused: a ms epoch or a garbage value must not keep him asleep for days.
+constexpr long long kMyVectorNapMax_s = 4 * 60 * 60;
+bool MyVectorNapActive(long long until_s, long long now_s)
+{
+  return until_s > now_s && until_s - now_s <= kMyVectorNapMax_s;
+}
+} // namespace (my-vector nap)
+
 
 namespace Anki {
 namespace Vector {
@@ -88,6 +99,36 @@ CONSOLE_VAR(bool, kSleepCycle_EnableWiggleWhileSleeping, CONSOLE_GROUP, true);
 CONSOLE_VAR(bool, kSleepCycleForceSleep, CONSOLE_GROUP, false);
 
 CONSOLE_VAR(bool, kSleepCycleForceLightSleep, CONSOLE_GROUP, false);
+
+// my-vector night window: inside SleepTracker::IsNightTime() sleep is always deep (no sound/light wake or reaction),
+// awake-and-idle goes straight back to sleep (silently, no get-in), and person checks wait for morning. Only voice,
+// timer, SDK, touch and pick-up wake him. Console vars reset on a vic-engine restart; this one doesn't undo the morning hour.
+CONSOLE_VAR(bool, kSleepCycle_NightWindow, CONSOLE_GROUP, true);
+// Inside the window the next person check is this close: it waits for morning anyway, so it runs soon after the window
+// ends (a 4 h deep-sleep interval set at 08:30 would keep him asleep until 12:30).
+CONSOLE_VAR(f32, kSleepCycle_NightPersonCheckDelay_s, CONSOLE_GROUP, 15 * 60.0f);
+// my-vector nap: epoch seconds the night rules hold until (0 = off), set by wire-pod's shut-up lock. Resets on engine restart.
+CONSOLE_VAR(int, kSleepCycle_NapUntil_s, CONSOLE_GROUP, 0);
+// my-vector night window: the one test its three rules share; a nap counts as night
+static bool MyVectorNight(const SleepTracker& sleepTracker)
+{
+  if( !kSleepCycle_NightWindow ) {
+    return false;
+  }
+  const long long until_s = kSleepCycle_NapUntil_s;
+  const long long now_s = time(nullptr);
+  const bool nap = MyVectorNapActive(until_s, now_s);
+  static long long sLoggedUntil_s = 0;
+  if( until_s != sLoggedUntil_s ) {
+    sLoggedUntil_s = until_s;
+    if( nap ) {
+      LOG_INFO("my-vector.NightWindow", "nap until %lld", until_s);
+    } else if( until_s > now_s ) {
+      LOG_INFO("my-vector.NightWindow", "nap refused %lld (more than %lld s ahead)", until_s, kMyVectorNapMax_s);
+    }
+  }
+  return nap || sleepTracker.IsNightTime();
+}
 // The amount of time that the robot must be on the charger but not actually charging
 // because of overheating battery before he is forced to go to sleep.
 CONSOLE_VAR(f32, kSleepCycle_TooLongOnChargerNotChargingDuration_sec, CONSOLE_GROUP, 5 * 60.f);
@@ -580,10 +621,25 @@ void BehaviorSleepCycle::BehaviorUpdate()
       }
     }
 
+    const bool nightWindow = MyVectorNight(GetBEI().GetSleepTracker());
+
+    // my-vector night window: light sleep (it wakes and reacts on sounds and lights) turns deep once night starts
+    if( nightWindow &&
+        _dVars.currState == SleepStateID::LightSleep &&
+        _dVars.reactionState == SleepReactionType::NotReacting ) {
+      LOG_INFO("my-vector.NightWindow", "light sleep -> deep sleep");
+      SetState(SleepStateID::DeepSleep);
+      _dVars.nextPersonCheckTime_s = currTime_s + kSleepCycle_NightPersonCheckDelay_s;
+      SendGoToSleepDasEvent(SleepReason::NightWindow);
+      return;
+    }
+
     if( _dVars.currState == SleepStateID::LightSleep ||
         _dVars.currState == SleepStateID::DeepSleep ) {
 
-      if( _dVars.nextPersonCheckTime_s > 0.0f &&
+      // my-vector night window: a person check opens the eyes and wakes on a face, so a due one waits for morning
+      if( !nightWindow &&
+          _dVars.nextPersonCheckTime_s > 0.0f &&
           currTime_s >= _dVars.nextPersonCheckTime_s ) {
         LOG_INFO("BehaviorSleepCycle.TimeForPersonCheck",
                  "In state '%s', reached t=%f (>= %f), time to do a person check",
@@ -703,6 +759,24 @@ bool BehaviorSleepCycle::GoToSleepIfNeeded()
     return true;
   }
 
+  // my-vector night window: idle and awake at night (after a voice command, a reboot or a touch) -> back to deep sleep
+  // at once, skipping the wokeRecently grace. No get-in anim: a flapping touch sensor would otherwise add a get-in to
+  // every wake-up anim all night. Busy features (voice, SDK, timer) and a pending intent finish first.
+  if( MyVectorNight(GetBEI().GetSleepTracker()) &&
+      !uic.IsAnyUserIntentPending() ) {
+    const ActiveFeature feature = GetBehaviorComp<ActiveFeatureComponent>().GetActiveFeature();
+    if( feature == ActiveFeature::Observing || feature == ActiveFeature::ObservingOnCharger ) {
+      LOG_INFO("my-vector.NightWindow", "awake at night -> sleep");
+      GetBEI().GetSleepTracker().EnsureSleepDebtAtLeast( kSleepCycle_MinSleepDebt_s );
+      const bool playSleepGetIn = false;
+      SleepTransitionHelper(SleepStateID::DeepSleep, playSleepGetIn);
+      _dVars.nextPersonCheckTime_s = BaseStationTimer::getInstance()->GetCurrentTimeInSeconds() +
+                                     kSleepCycle_NightPersonCheckDelay_s;
+      SendGoToSleepDasEvent(SleepReason::NightWindow);
+      return true;
+    }
+  }
+
   const float currTime_s = BaseStationTimer::getInstance()->GetCurrentTimeInSeconds();
   const bool wokeRecently = _dVars.lastWakeUpTime_s > 0.0f &&
     ( currTime_s - _dVars.lastWakeUpTime_s ) <= kSleepCycle_RecentSleepLength_s;
@@ -996,8 +1070,11 @@ void BehaviorSleepCycle::TransitionToDeepSleep()
 {
   SleepTransitionHelper(SleepStateID::DeepSleep);
 
+  // my-vector night window: the check waits for morning, so keep it close (kSleepCycle_NightPersonCheckDelay_s)
+  const bool nightWindow = MyVectorNight(GetBEI().GetSleepTracker());
   const float currTime_s = BaseStationTimer::getInstance()->GetCurrentTimeInSeconds();
-  _dVars.nextPersonCheckTime_s = currTime_s + kSleepCycle_DeepSleep_PersonCheckInterval_s;
+  _dVars.nextPersonCheckTime_s = currTime_s + ( nightWindow ? kSleepCycle_NightPersonCheckDelay_s
+                                                            : kSleepCycle_DeepSleep_PersonCheckInterval_s );
 }
 
