From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kristjan Sillmann <kristjan.h.s@gmail.com>
Date: Mon, 9 Nov 2026 06:24:28 +0200
Subject: [PATCH] silent-start

vic-engine: while /data/myvector/silent-start holds an expiry epoch (s, robot clock) still ahead and at most 15 min
ahead, an AnimSequence holding the InitialWakeUp trigger (NormalWakeUp, the power-on anim after each engine start) ends
without playing it, a tick after activation via a 0 s wait (as a played anim ends): a CancelSelf() inside activation
left InitNormalOperation, the always-delegating stack base, with no delegate that tick, so it cancelled itself and
emptied the behavior stack. Ending rather than refusing to activate starts InitNormalOperation's run-once cooldown,
so it never replays later. A missing, empty, garbage, expired or over-cap file plays the anim.
restarts.sh -s / catch.sh -s write now + 300 s (600 s with -d) before each restart; ship.sh writes now + 600 s
while the robot sound lock holds. Logs my-vector.SilentStart. Host test: robot/firmware/tests/silent-start.sh.
---
 .../behaviorAnimSequence.cpp                  | 67 +++++++++++++++++++
 1 file changed, 67 insertions(+)

diff --git a/engine/aiComponent/behaviorComponent/behaviors/animationWrappers/behaviorAnimSequence.cpp b/engine/aiComponent/behaviorComponent/behaviors/animationWrappers/behaviorAnimSequence.cpp
index 87c8eef2..cb101b7b 100644
--- a/engine/aiComponent/behaviorComponent/behaviors/animationWrappers/behaviorAnimSequence.cpp
+++ b/engine/aiComponent/behaviorComponent/behaviors/animationWrappers/behaviorAnimSequence.cpp
@@ -13,10 +13,18 @@
 #include "engine/aiComponent/behaviorComponent/behaviors/animationWrappers/behaviorAnimSequence.h"
 
 #include "engine/actions/animActions.h"
+#include "engine/actions/basicActions.h"
 #include "engine/aiComponent/behaviorComponent/behaviorExternalInterface/behaviorExternalInterface.h"
 #include "engine/aiComponent/behaviorComponent/behaviorExternalInterface/beiRobotInfo.h"
 #include "util/cladHelpers/cladFromJSONHelpers.h"
 
+#include <algorithm>
+#include <cctype>
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <ctime>
+
 namespace Anki {
 namespace Vector {
   
@@ -30,6 +38,47 @@ const char* kTracksToLock   = "tracksToLock";
 const char* kRenderInEyeHue = "renderInEyeHue";
 }
 
+namespace { // my-vector silent start
+// restarts.sh -s / catch.sh -s, and ship.sh while the sound lock holds, write an expiry epoch (s, robot clock) here
+// before an engine restart. It is honoured only until then, so a file left behind expires on its own.
+const char* const kMyVectorSilentStartFile = "/data/myvector/silent-start";
+// An expiry further ahead than this is ignored (plays), like patch 0011's nap cap: a ms epoch, a garbage number or a
+// clock that jumped back must not silence every later start.
+constexpr long long kMyVectorSilentStartMax_s = 15 * 60;
+
+// The flag's expiry: the file's one decimal epoch (whitespace around it allowed); -1 = no file, empty or not a number.
+long long MyVectorSilentStartExpiry()
+{
+  FILE* f = fopen(kMyVectorSilentStartFile, "r");
+  if (f == nullptr) {
+    return -1;
+  }
+  char buf[32];
+  const size_t n = fread(buf, 1, sizeof(buf) - 1, f);
+  fclose(f);
+  buf[n] = '\0';
+  char* end = nullptr;
+  errno = 0;
+  const long long v = strtoll(buf, &end, 10);
+  if (end == buf || errno != 0) {
+    return -1;
+  }
+  while (isspace(static_cast<unsigned char>(*end))) {
+    ++end;
+  }
+  return *end == '\0' ? v : -1;
+}
+
+// True: skip this activation's anims; until_s gets the flag's expiry (-1 = none read). Only a sequence holding the
+// InitialWakeUp trigger (NormalWakeUp, the power-on anim InitNormalOperation plays once per engine start) is skipped,
+// and only while now_s < expiry <= now_s + kMyVectorSilentStartMax_s.
+bool MyVectorSilentStart(bool hasInitialWakeUp, long long now_s, long long& until_s)
+{
+  until_s = hasInitialWakeUp ? MyVectorSilentStartExpiry() : -1;
+  return until_s > now_s && until_s - now_s <= kMyVectorSilentStartMax_s;
+}
+} // namespace (my-vector silent start)
+
 
 // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 BehaviorAnimSequence::InstanceConfig::InstanceConfig() :
@@ -121,6 +170,24 @@ bool BehaviorAnimSequence::WantsToBeActivatedBehavior() const
 // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 void BehaviorAnimSequence::OnBehaviorActivated()
 {
+  const auto& triggers = _iConfig.animTriggers;
+  const bool hasInitialWakeUp = std::find(triggers.begin(), triggers.end(), AnimationTrigger::InitialWakeUp) != triggers.end();
+  const long long now_s = time(nullptr);
+  long long until_s = -1;
+  if (MyVectorSilentStart(hasInitialWakeUp, now_s, until_s)) {
+    // Ending (not refusing WantsToBeActivated) lets InitNormalOperation start the -1 cooldown, so it never replays.
+    // End on a later tick, through a 0 s wait's callback, as a played anim ends: a CancelSelf() here runs inside the
+    // dispatcher's DelegateNow, so InitNormalOperation (always delegates, bottom of the stack) finds no delegate that
+    // same tick and cancels itself, leaving vic-engine with an empty behavior stack (NoStackInitialized, 2026-11-09).
+    LOG_CH_INFO("Behaviors", "my-vector.SilentStart", "%s: %s holds %lld (%lld s ahead), InitialWakeUp skipped",
+                GetDebugLabel().c_str(), kMyVectorSilentStartFile, until_s, until_s - now_s);
+    DelegateIfInControl(new WaitAction(0.f), [this]() { CancelSelf(); });
+    return;
+  }
+  if (until_s != -1) {
+    LOG_CH_INFO("Behaviors", "my-vector.SilentStart", "%s: %s holds %lld, now %lld: expired or over %lld s ahead, plays",
+                GetDebugLabel().c_str(), kMyVectorSilentStartFile, until_s, now_s, kMyVectorSilentStartMax_s);
+  }
   StartPlayingAnimations();
 }
 
