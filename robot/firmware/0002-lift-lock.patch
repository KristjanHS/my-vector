From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kristjan Sillmann <kristjan.h.s@gmail.com>
Date: Wed, 4 Nov 2026 07:48:17 +0200
Subject: [PATCH] lift-lock

---
 engine/actions/animActions.cpp          |  9 ++++++---
 engine/actions/basicActions.cpp         |  3 ++-
 engine/components/movementComponent.cpp |  7 +++++++
 engine/components/movementComponent.h   |  2 ++
 robot/supervisor/src/liftController.cpp | 10 +++++-----
 5 files changed, 22 insertions(+), 9 deletions(-)

diff --git a/engine/actions/animActions.cpp b/engine/actions/animActions.cpp
index 15c3d76b..f15cc4c7 100644
--- a/engine/actions/animActions.cpp
+++ b/engine/actions/animActions.cpp
@@ -60,7 +60,8 @@ namespace Anki {
                                              AnimationComponent::AnimationCompleteCallback callback)
     : IAction("PlayAnimation" + animName,
               RobotActionType::PLAY_ANIMATION,
-              tracksToLock)
+              // my-vector lift lock: LIFT_TRACK is held for good, so never require it
+              tracksToLock & ~(u8)AnimTrackFlag::LIFT_TRACK)
     , _animName(animName)
     , _numLoopsRemaining(numLoops)
     , _interruptRunning(interruptRunning)
@@ -363,7 +364,8 @@ namespace Anki {
 
     void TriggerLiftSafeAnimationAction::OnRobotSetInternalTrigger()
     {
-      SetTracksToLock(TracksToLock(GetRobot(), GetTracksToLock()));
+      // my-vector lift lock: LIFT_TRACK is held for good, so never require it
+      SetTracksToLock(TracksToLock(GetRobot(), GetTracksToLock()) & ~(u8)AnimTrackFlag::LIFT_TRACK);
     }
     
     #pragma mark ---- ReselectingLoopAnimationAction ----
@@ -376,7 +378,8 @@ namespace Anki {
                                                                    bool strictCooldown)
       : IAction(GetDebugString(animEvent),
                 RobotActionType::RESELECTING_LOOP_ANIMATION,
-                tracksToLock)
+                // my-vector lift lock: LIFT_TRACK is held for good, so never require it
+                tracksToLock & ~(u8)AnimTrackFlag::LIFT_TRACK)
       , _numLoops( numLoops )
       , _loopForever( 0 == numLoops )
       , _numLoopsRemaining( numLoops )
diff --git a/engine/actions/basicActions.cpp b/engine/actions/basicActions.cpp
index ee63e04b..e52972b1 100644
--- a/engine/actions/basicActions.cpp
+++ b/engine/actions/basicActions.cpp
@@ -879,7 +879,8 @@ namespace Anki {
                                                const MotorCalibrationReason& reason)
     : IAction("CalibrateMotor-" + std::string(calibrateHead ? "Head" : "") + std::string(calibrateLift ? "Lift" : ""),
               RobotActionType::CALIBRATE_MOTORS,
-              (calibrateHead ? (u8)AnimTrackFlag::HEAD_TRACK : 0) | (calibrateLift ? (u8)AnimTrackFlag::LIFT_TRACK : 0) )
+              // my-vector lift lock: LIFT_TRACK is locked for good, so calibration must not wait on it
+              (calibrateHead ? (u8)AnimTrackFlag::HEAD_TRACK : 0) )
     , _calibHead(calibrateHead)
     , _calibLift(calibrateLift)
     , _calibReason(reason)
diff --git a/engine/components/movementComponent.cpp b/engine/components/movementComponent.cpp
index 57a66a7a..6ca7b9b0 100644
--- a/engine/components/movementComponent.cpp
+++ b/engine/components/movementComponent.cpp
@@ -62,6 +62,7 @@ void MovementComponent::InitDependent(Vector::Robot* robot, const RobotCompMap&
 {
   _robot = robot;
   _animComponent = dependentComps.GetComponentPtr<AnimationComponent>();
+  LockTracks((u8)AnimTrackFlag::LIFT_TRACK, kLiftLockOwner, kLiftLockOwner);
   if (_robot->HasExternalInterface())
   {
     InitEventHandlers(*(_robot->GetExternalInterface()));
@@ -116,6 +117,11 @@ void MovementComponent::OnRobotDelocalized()
   
 void MovementComponent::NotifyOfRobotState(const Vector::RobotState& robotState)
 {
+  // my-vector lift lock: the InitDependent send predates the robot connection, so resend once connected
+  if (!_liftLockSynced) {
+    _liftLockSynced = (_robot->SendRobotMessage<RobotInterface::SetFullAnimTrackLockState>(GetLockedTracks()) == RESULT_OK);
+  }
+
   #define IS_STATUS_FLAG_SET(x) ((robotState.status & (uint32_t)RobotStatusFlag::x) != 0)
 
   _isMoving            =  IS_STATUS_FLAG_SET(IS_MOVING);
@@ -957,6 +963,7 @@ void MovementComponent::UnlockAllTracks()
     }
   }
 
+  LockTracks((u8)AnimTrackFlag::LIFT_TRACK, kLiftLockOwner, kLiftLockOwner);
   _robot->SendRobotMessage<RobotInterface::SetFullAnimTrackLockState>(GetLockedTracks());
 }
 
diff --git a/engine/components/movementComponent.h b/engine/components/movementComponent.h
index 66bb96d5..ad239fa2 100644
--- a/engine/components/movementComponent.h
+++ b/engine/components/movementComponent.h
@@ -385,9 +385,11 @@ private:
   bool _drivingWheels     = false;
   bool _drivingHead       = false;
   bool _drivingLift       = false;
+  bool _liftLockSynced    = false; // my-vector lift lock: lock state reached the anim process
   const char* kDrivingWheelsStr  = "DirectDriveWheels";
   const char* kDrivingHeadStr    = "DirectDriveHead";
   const char* kDrivingLiftStr    = "DirectDriveLift";
+  const char* kLiftLockOwner     = "my-vector-lift-lock";
   const char* kDrivingArcStr     = "DirectDriveArc";
   const char* kDrivingTurnStr    = "DirectDriveTurnInPlace";
   const char* kOnChargerInSdkStr = "OnChargerInSDK";
diff --git a/robot/supervisor/src/liftController.cpp b/robot/supervisor/src/liftController.cpp
index 6349dae6..b66ee5ad 100644
--- a/robot/supervisor/src/liftController.cpp
+++ b/robot/supervisor/src/liftController.cpp
@@ -226,7 +226,8 @@ namespace Anki {
 
       void SetPower(f32 power)
       {
-        power_ = power;
+        // my-vector lift lock: the lift motor never gets power
+        power_ = 0.f;
         HAL::MotorSetPower(MotorID::MOTOR_LIFT, power_);
       }
 
@@ -514,6 +515,7 @@ namespace Anki {
                                     const f32 accel_rad_per_sec2,
                                     bool useVPG)
       {
+        return; // my-vector lift lock: no setpoints, so inPosition_ stays true (LIFT_IN_POS)
 #if DISABLE_MOTORS_ON_CHARGER
         // If a lift motion is commanded while the robot is on charger,
         // re-enable the motor as long as it wasn't disabled external to
@@ -758,10 +760,8 @@ namespace Anki {
 
         PoseAndSpeedFilterUpdate();
 
-        // Check encoder validity
-        if (HAL::IsLiftEncoderInvalid() && encoderInvalidStartTime_ms_ == 0) {
-          encoderInvalidStartTime_ms_ = HAL::GetTimeStamp();
-        }
+        // my-vector lift lock: syscon clears lift_invalid only while the lift is driven, which it never is,
+        // so latching it here would re-raise ENCODER_LIFT_INVALID after every calibration (endless recalibration loop)
 
         if (!IsCalibrated()) {
           return RESULT_OK;
