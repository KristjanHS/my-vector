-		}
 		numCommandsSentFromSDK++
 		_, _, err = engineProtoManager.Write(msg)
 		if err != nil {
@@ -3710,14 +3748,12 @@ func (service *rpcService) ExternalAudioStreamResponseHandler(out extint.Externa
 				return grpc.Errorf(codes.Internal, "Failed to retrieve message")
 			}
 			msg := response.GetExternalAudioStreamResponse()
-			switch msg.GetAudioResponseType().(type) {
-			case *extint.ExternalAudioStreamResponse_AudioStreamPlaybackComplete:
-				if st.completeSent.Load() { // else a stale broadcast of the previous stream's OnAudioCompleted
-					st.verdict.Store(true)
-				}
-			case *extint.ExternalAudioStreamResponse_AudioStreamBufferOverrun,
-				*extint.ExternalAudioStreamResponse_AudioStreamPlaybackFailyer:
-				st.verdict.Store(true) // Failure includes this stream's own PrepareFailed: a Cancel would hit the previous stream
+			if msg.GetStreamId() != st.id { // a late status of an earlier stream: the engine broadcasts to whichever stream is open
+				log.Printf("my-vector.SdkAudioOrphan: status of stream %d not sent on stream %d\n", msg.GetStreamId(), st.id)
+				continue
+			}
+			if myVectorAudioVerdict(st, msg) {
+				st.verdict.Store(true)
 			}
 			if err := out.Send(msg); err != nil {
 				log.Println("Closing AudioStream (on send):", err)
@@ -3755,7 +3791,8 @@ func (service *rpcService) ExternalAudioStreamPlayback(bidirectionalStream extin
 	f, audioStreamStatus := engineProtoManager.CreateChannel(&extint.GatewayWrapper_ExternalAudioStreamResponse{}, 1)
 	defer f()
 
-	st := &myVectorAudioStream{}
+	st := &myVectorAudioStream{id: myVectorAudioStreamSeq.Add(1)}
+	log.Printf("my-vector.SdkAudioOrphan: audio stream %d opened\n", st.id)
 	go service.ExternalAudioStreamRequestHandler(bidirectionalStream, done, st)
 	return service.ExternalAudioStreamResponseHandler(bidirectionalStream, audioStreamStatus, done, st)
 }
