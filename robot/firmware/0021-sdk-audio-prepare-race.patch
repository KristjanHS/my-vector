     return;
   }
+  if (!IsPreparedStream("Chunk", msg.stream_id, true)) {
+    return;
+  }
 
   //add our wave data to the playing instance
   if (!AddAudioChunk(msg)) {
@@ -211,6 +221,7 @@ bool SdkAudioComponent::PrepareAudioEngine(const RobotInterface::ExternalAudioPr
 
   _audioRate = msg.audio_rate;
   _totalAudioFramesReceived = 0;
+  _streamId = msg.stream_id; // my-vector sdk-audio-prepare-race: kept after ClearOperationData, so the end status carries it
   _audioPrepared = true;
 
   return true;
@@ -365,15 +376,39 @@ void SdkAudioComponent::OnAudioCompleted()
 // Send audio streaming status message to Engine process
 //
 bool SdkAudioComponent::SendAnimToEngine(SDKAudioStreamingState audioState, uint32_t audioSent, uint32_t audioPlayed)
+{
+  return SendAnimToEngine(audioState, audioSent, audioPlayed, _streamId);
+}
+
+bool SdkAudioComponent::SendAnimToEngine(SDKAudioStreamingState audioState, uint32_t audioSent, uint32_t audioPlayed,
+                                         uint32_t streamId)
 {
   LOG_DEBUG("sdkAudioComponent.SendAnimToEngine", 
-            "audioState %d audioSent %d audioPlayed %d", (int)audioState, audioSent, audioPlayed);
+            "audioState %d audioSent %d audioPlayed %d stream %u", (int)audioState, audioSent, audioPlayed, streamId);
   AudioStreamStatusEvent evt;
   evt.streamResultID = audioState;
   evt.audioReceived = audioSent;  //used only for ChunkAdded messages
   evt.audioPlayed = audioPlayed;  //used only for ChunkAdded messages
+  evt.streamId = streamId;        // my-vector sdk-audio-prepare-race: the gateway takes only its own stream's statuses
   return AnimProcessMessages::SendAnimToEngine(std::move(evt));
 }
 
+//
+// my-vector sdk-audio-prepare-race: only the stream accepted on Prepare feeds, completes or cancels the playing one
+//
+bool SdkAudioComponent::IsPreparedStream(const char* what, uint32_t streamId, bool chunk)
+{
+  if (streamId == _streamId) {
+    return true;
+  }
+  if (!chunk || streamId != _droppedChunkStreamId) { // one line per foreign stream's chunks, not one per chunk
+    LOG_WARNING("my-vector.SdkAudioOrphan", "%s of stream %u dropped: stream %u is prepared", what, streamId, _streamId);
+  }
+  if (chunk) {
+    _droppedChunkStreamId = streamId;
+  }
+  return false;
+}
+
 }   // end namespace Anki
 }   // end namespace Vector
