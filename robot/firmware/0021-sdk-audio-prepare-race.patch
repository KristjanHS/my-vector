@@ -3613,9 +3615,47 @@ func (service *rpcService) ExternalAudioStreamRequestToGatewayWrapper(request *e
 const myVectorAudioIdleTimeout = 15 * time.Second
 
 type myVectorAudioStream struct {
-	verdict      atomic.Bool // the engine answered this stream (Complete/Overrun/Failure); a Cancel now would hit the next stream
-	completeSent atomic.Bool // this stream sent Complete; only then is a PlaybackComplete its own, not the previous stream's late one
-	timedOut     bool        // written before done closes
+	id       uint32      // my-vector sdk-audio-prepare-race: stamped on every request; only statuses with it are this stream's
+	verdict  atomic.Bool // the engine answered this stream (Complete/Overrun/Failure); a Cancel now would hit the next stream
+	timedOut bool        // written before done closes
+}
+
+// my-vector sdk-audio-prepare-race: the gateway's id replaces any client value (vic-anim acts only on the prepared id)
+func myVectorStampAudioRequest(request *extint.ExternalAudioStreamRequest, id uint32) {
+	switch r := request.AudioRequestType.(type) {
+	case *extint.ExternalAudioStreamRequest_AudioStreamPrepare:
+		if r.AudioStreamPrepare != nil {
+			r.AudioStreamPrepare.StreamId = id
+		}
+	case *extint.ExternalAudioStreamRequest_AudioStreamChunk:
+		if r.AudioStreamChunk != nil {
+			r.AudioStreamChunk.StreamId = id
+		}
+	case *extint.ExternalAudioStreamRequest_AudioStreamComplete:
+		if r.AudioStreamComplete == nil {
+			r.AudioStreamComplete = &extint.ExternalAudioStreamComplete{}
+		}
+		r.AudioStreamComplete.StreamId = id
+	case *extint.ExternalAudioStreamRequest_AudioStreamCancel:
+		if r.AudioStreamCancel == nil {
+			r.AudioStreamCancel = &extint.ExternalAudioStreamCancel{}
+		}
+		r.AudioStreamCancel.StreamId = id
+	}
+}
+
+// my-vector sdk-audio-prepare-race: whether a status ends st (a status of another stream id is never st's verdict)
+func myVectorAudioVerdict(st *myVectorAudioStream, msg *extint.ExternalAudioStreamResponse) bool {
+	if msg.GetStreamId() != st.id {
+		return false
+	}
+	switch msg.GetAudioResponseType().(type) {
+	case *extint.ExternalAudioStreamResponse_AudioStreamPlaybackComplete,
+		*extint.ExternalAudioStreamResponse_AudioStreamBufferOverrun,
+		*extint.ExternalAudioStreamResponse_AudioStreamPlaybackFailyer:
+		return true // Failure includes this stream's own PrepareFailed
+	}
+	return false
 }
 
