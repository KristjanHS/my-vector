+    mv.sentences = MyVectorSplitSentences(text);
+    mv.next = 0;
+    mv.durationScalar = durationScalar;
+    mv.pitchScalar = pitchScalar;
+    mv.active = !mv.sentences.empty();
+    why = "no sentences";
+  }
+  if (mv.active) {
+    LOG_WARNING("my-vector.Voice", "pc voice=%s %s:%d sentences=%zu slow=%.2f duration=%.2f",
+                mv.voice.c_str(), mv.host.c_str(), mv.port, mv.sentences.size(), mv.slow, durationScalar);
+    return GetNextMyVectorVoiceData(data, done);
+  }
+  LOG_WARNING("my-vector.Voice", "acapela: %s", why.c_str());
+  return GetFirstAcapelaData(text, durationScalar, pitchScalar, data, done);
+}
+
+Result TextToSpeechProviderImpl::GetNextMyVectorVoiceData(TextToSpeechProviderData & data, bool & done)
+{
+  auto & mv = _myVectorVoice;
+  if (mv.next >= mv.sentences.size()) {
+    mv.active = false;
+    done = true;
+    return RESULT_OK;
+  }
+  const auto & s = mv.sentences[mv.next];
+  const std::string say = MyVectorPlainText(mv.text.substr(s.first, s.second - s.first));
+  if (say.empty()) { // a sentence of \tags\ only
+    ++mv.next;
+    return RESULT_OK;
+  }
+  Json::Value req;
+  req["text"] = say;
+  req["voice"] = mv.voice;
+  req["slow"] = std::min(2.f, std::max(0.5f, mv.slow * mv.durationScalar)); // R16; server's range
+  std::string resp, why;
+  std::vector<int16_t> pcm;
+  if (MyVectorPost(mv.host, mv.port, mv.path, Json::FastWriter().write(req), resp, why) &&
+      MyVectorParseResponse(resp, pcm, why)) {
+    ++mv.next;
+    // One rate per stream (StreamingWaveDataInstance drops a changed rate): match Acapela's so a fallback can follow.
+    const int rate = _BAB_voicefreq > 0 ? static_cast<int>(_BAB_voicefreq) : kMyVectorPcRate;
+    pcm = MyVectorResample(pcm, kMyVectorPcRate, rate);
+    if (!pcm.empty()) {
+      data.Init(rate, 1);
+      data.AppendSamples(pcm.data(), pcm.size());
+    }
+    return RESULT_OK;
+  }
+  LOG_WARNING("my-vector.Voice", "acapela from sentence %zu/%zu: %s",
+              mv.next + 1, mv.sentences.size(), why.c_str());
+  mv.active = false; // R17: this sentence and the rest of the line
+  return GetFirstAcapelaData(mv.text.substr(s.first), mv.durationScalar, mv.pitchScalar, data, done);
+}
