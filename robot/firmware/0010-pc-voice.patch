 // Acapela SDK declarations
 #include "i_babile.h"
@@ -113,6 +114,20 @@ private:
   Result Initialize(const std::string & locale);
   void Cleanup();
 
+  // my-vector voice (patch 0010): PC TTS one sentence per POST; after a failure the rest goes to Acapela
+  struct MyVectorVoice {
+    bool active = false;
+    std::string host, path, voice;
+    int port = 0;
+    float slow = 1.f, durationScalar = 1.f, pitchScalar = 1.f;
+    std::string text;
+    std::vector<std::pair<size_t, size_t>> sentences; // [begin, end) into text
+    size_t next = 0;
+  } _myVectorVoice;
+  Result GetFirstAcapelaData(const std::string & text, float durationScalar, float pitchScalar,
+                             TextToSpeechProviderData & data, bool & done);
+  Result GetNextMyVectorVoiceData(TextToSpeechProviderData & data, bool & done);
+
 }; // class TextToSpeechProviderImpl
 
 } // end namespace TextToSpeech
