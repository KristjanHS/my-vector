+++ b/animProcess/src/cozmoAnim/textToSpeech/textToSpeechProvider_vicos.cpp
@@ -24,6 +24,20 @@
 #include "util/environment/locale.h"
 #include "util/logging/logging.h"
 
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <unistd.h>
