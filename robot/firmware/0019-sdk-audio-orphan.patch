From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kristjan Sillmann <kristjan.h.s@gmail.com>
Date: Mon, 9 Nov 2026 16:30:00 +0200
Subject: [PATCH] sdk-audio-orphan

vic-anim (plan 2026-11-09-sdk-audio-orphan B): an SDK audio Prepare arriving while a stream plays is refused
(PrepareFailed, logs my-vector.SdkAudioOrphan) without clearing the playing stream's state, so its chunks and its
Complete/Cancel still land. ClearOperationData ends the wave data whenever it holds one (SDK and TTS):
IsPlayingStream() is never true, and the Wwise FX keeps its own ref, so a dropped stream starved forever ("No Data,
plugin will be starved" ~60/s). Cancel's StopActiveAudio stops the kSdkGameObject game object (it passed the Stop
event id as the game object: stopped nothing). Each ClearOperationData bumps a playback counter, so the end
callback of a stopped playback no longer clears a later stream nor reports it Completed.
B2: AddAudioChunk drops (AddAudioFailed + cleanup) a chunk with no wave data, a plugin instance other than the
prepared stream's, or a size past the CLAD array. Complete on a stream never posted (under 0.2 s of audio) posts
its audio, or, when empty, clears it and reports Completed: it held the one slot forever and every later Prepare
was refused.
vic-cloud gateway: one open ExternalAudioStreamPlayback at a time; a second gets ResourceExhausted (vic-anim
cannot tell streams apart: B's chunks and Complete landed on A). A stream closing after Prepare without Complete
or Cancel sends the engine Cancel; the slot frees only after it, so that Cancel cannot hit the next stream.
Falsifier: voiceprobe overlap, A hears AudioStreamPlaybackComplete, B ends ResourceExhausted, C/D/F hear
AudioStreamPlaybackComplete, no starved / VERIFY(_audioPrepared) line.
---
 .../src/cozmoAnim/audio/sdkAudioComponent.cpp | 56 +++++++++--
 .../textToSpeech/textToSpeechComponent.cpp    |  3 +-
 cloud/cloud/message_handler.go                | 92 +++++++++++++++++--
 3 files changed, 135 insertions(+), 16 deletions(-)

diff --git a/animProcess/src/cozmoAnim/audio/sdkAudioComponent.cpp b/animProcess/src/cozmoAnim/audio/sdkAudioComponent.cpp
index 8d6776c4..eb1922e3 100644
--- a/animProcess/src/cozmoAnim/audio/sdkAudioComponent.cpp
+++ b/animProcess/src/cozmoAnim/audio/sdkAudioComponent.cpp
@@ -36,6 +36,8 @@
 namespace {
   constexpr Anki::AudioMetaData::GameObjectType kSdkGameObject = Anki::AudioMetaData::GameObjectType::TextToSpeech;
   constexpr Anki::AudioEngine::PlugIns::StreamingWavePortalPlugIn::PluginId_t kSdkPluginId = 100;
+  // my-vector sdk-audio-orphan: bumped by ClearOperationData; an older playback's end callback (after Cancel) is dropped
+  uint32_t sMyVectorSdkPlayback = 0;
 }
 
 namespace Anki {
@@ -70,7 +72,24 @@ void SdkAudioComponent::HandleMessage(const RobotInterface::ExternalAudioComplet
   if (ANKI_VERIFY(_audioPrepared, 
                     "SdkAudioComponent.HandleMessage.ExternalAudioComplete", 
                     "Audio stream complete message received without start")) {
-    _waveData->DoneProducingData();      
+    if (!_audioPosted) {
+      // my-vector sdk-audio-orphan: under AUDIO_TO_BEGIN_PLAYING_SEC nothing was posted, so no end callback would clear it
+      if (_totalAudioFramesReceived == 0) {
+        LOG_WARNING("my-vector.SdkAudioOrphan", "Complete on an empty unposted stream: cleared, reported Completed");
+        ClearOperationData();
+        SendAnimToEngine(SDKAudioStreamingState::Completed, 0, 0);
+        return;
+      }
+      if (!PostAudioEvent()) {
+        LOG_ERROR("SdkAudioComponent.HandleMessage.ExternalAudioComplete", "Unable to post audio event Audio Streaming");
+        SendAnimToEngine(SDKAudioStreamingState::PostFailed);
+        CleanupAudioEngine();
+        return;
+      }
+      LOG_WARNING("my-vector.SdkAudioOrphan", "Complete on an unposted stream: posted its %u frames", _totalAudioFramesReceived);
+      _audioPosted = true;
+    }
+    _waveData->DoneProducingData();
   }
 }
 
@@ -95,6 +114,12 @@ void SdkAudioComponent::HandleMessage(const RobotInterface::ExternalAudioPrepare
   LOG_DEBUG("SdkAudioComponent.HandleMessage.ExternalAudioPrepare", 
            "Sample rate %d, volume %d", msg.audio_volume, msg.audio_rate );
 
+  if (_audioPrepared) {
+    // my-vector sdk-audio-orphan: no ClearOperationData here, it would orphan the playing stream
+    LOG_WARNING("my-vector.SdkAudioOrphan", "Prepare refused: a stream is playing, it keeps playing");
+    SendAnimToEngine(SDKAudioStreamingState::PrepareFailed);
+    return;
+  }
   if (!PrepareAudioEngine(msg)) {
     LOG_DEBUG("SdkAudioComponent.HandleMessage.ExternalAudioPrepare", "Unable to prepare audio engine for streaming");
     SendAnimToEngine(SDKAudioStreamingState::PrepareFailed);
@@ -197,9 +222,17 @@ bool SdkAudioComponent::PrepareAudioEngine(const RobotInterface::ExternalAudioPr
 bool SdkAudioComponent::AddAudioChunk(const RobotInterface::ExternalAudioChunk& msg) {
   //check for dangerous buffer expansion
   auto * pluginInterface = _audioController->GetPluginInterface();
-  auto * plugin = pluginInterface->GetStreamingWavePortalPlugIn();
-  const auto played = plugin->GetDataInstance(kSdkPluginId)->GetNumberOfFramesPlayed();
-  const auto received = plugin->GetDataInstance(kSdkPluginId)->GetNumberOfFramesReceived();
+  auto * plugin = (pluginInterface != nullptr) ? pluginInterface->GetStreamingWavePortalPlugIn() : nullptr;
+  // my-vector sdk-audio-orphan: a chunk the prepared stream cannot take is dropped (false = cleanup), never dereferenced
+  const auto instance = (plugin != nullptr) ? plugin->GetDataInstance(kSdkPluginId) : nullptr;
+  if (!_waveData || instance != _waveData || msg.audio_chunk_size > sizeof(msg.audio_chunk_data)) {
+    LOG_WARNING("my-vector.SdkAudioOrphan", "Chunk dropped: no wave data, not the prepared stream, or %u bytes",
+                msg.audio_chunk_size);
+    SendAnimToEngine(SDKAudioStreamingState::AddAudioFailed);
+    return false;
+  }
+  const auto played = instance->GetNumberOfFramesPlayed();
+  const auto received = instance->GetNumberOfFramesReceived();
   LOG_DEBUG("SdkAudioComponent::AddAudioChunk", "Played %u Received %u", played, received);
   SendAnimToEngine(SDKAudioStreamingState::ChunkAdded, received, played);
 
@@ -241,8 +274,12 @@ bool SdkAudioComponent::PostAudioEvent()
   // Register callback for event
   using namespace AudioEngine;
   std::weak_ptr<AudioCallbackType> weakOnFinished = _audioPlaybackFinishedPtr;
-  audioCallbackContext->SetEventCallbackFunc( [weakOnFinished]( const AudioCallbackContext* thisContext,
+  const uint32_t playback = sMyVectorSdkPlayback;
+  audioCallbackContext->SetEventCallbackFunc( [weakOnFinished, playback]( const AudioCallbackContext* thisContext,
                                                                      const AudioCallbackInfo& callbackInfo ) {
+    if (playback != sMyVectorSdkPlayback) {
+      return;
+    }
     // if the user logs out, this callback could fire after sdkAudioComponent is destroyed. check that here.
     auto callback = weakOnFinished.lock();
     if( callback && (*callback) ) {
@@ -280,11 +317,13 @@ void SdkAudioComponent::CleanupAudioEngine()
 void SdkAudioComponent::ClearOperationData()
 {
   LOG_DEBUG("SdkAudioComponent.ClearOperationData", "Clear Sdk Audio");
-  if (_waveData && _waveData->IsPlayingStream()) {
+  // my-vector sdk-audio-orphan: IsPlayingStream() is never true; the Wwise FX keeps its own ref, so end it here
+  if (_waveData) {
     //no more data coming
     _waveData->DoneProducingData();
   }
 
+  ++sMyVectorSdkPlayback;
   _audioPrepared = false;
   _audioPosted = false;
   _waveData = NULL;
@@ -296,9 +335,8 @@ void SdkAudioComponent::ClearOperationData()
 void SdkAudioComponent::StopActiveAudio()
 {
   LOG_DEBUG("SdkAudioComponent.StopActiveAudio", "Stop active Sdk audio");
-  using AudioEvent = AudioMetaData::GameEvent::GenericEvent;
-  const auto eventID = AudioEngine::ToAudioEventId( AudioEvent::Stop__Robot_Vic__External_Sdk_Playback_01 );
-  _audioController->StopAllAudioEvents(eventID);
+  // my-vector sdk-audio-orphan: StopAllAudioEvents takes a game object, not a Stop event id (stopped nothing)
+  _audioController->StopAllAudioEvents(static_cast<AudioEngine::AudioGameObject>(kSdkGameObject));
 }
 
 //
diff --git a/animProcess/src/cozmoAnim/textToSpeech/textToSpeechComponent.cpp b/animProcess/src/cozmoAnim/textToSpeech/textToSpeechComponent.cpp
index c595c34d..9b3b3aeb 100644
--- a/animProcess/src/cozmoAnim/textToSpeech/textToSpeechComponent.cpp
+++ b/animProcess/src/cozmoAnim/textToSpeech/textToSpeechComponent.cpp
@@ -331,7 +331,8 @@ void TextToSpeechComponent::ClearOperationData(const TTSID_t ttsID)
   if (it != _bundleMap.end()) {
     const auto & bundle = it->second;
     const auto & waveData = bundle->waveData;
-    if (waveData && waveData->IsPlayingStream()) {
+    // my-vector sdk-audio-orphan: IsPlayingStream() is never true; the Wwise FX keeps its own ref, so end it here
+    if (waveData) {
       waveData->DoneProducingData();
     }
     _bundleMap.erase(it);
diff --git a/cloud/cloud/message_handler.go b/cloud/cloud/message_handler.go
index 0d0ad73e..25deddcf 100644
--- a/cloud/cloud/message_handler.go
+++ b/cloud/cloud/message_handler.go
@@ -12,6 +12,7 @@ import (
 	"strconv"
 	"strings"
 	"sync"
+	"sync/atomic"
 	"time"
 
 	cloud_clad "github.com/digital-dream-labs/vector-cloud/internal/clad/cloud"
@@ -35,6 +36,9 @@ var (
 	statusStreamRunning bool
 	lastProgress        int64
 	lastExpected        int64
+
+	// my-vector sdk-audio-orphan: one open ExternalAudioStreamPlayback at a time (vic-anim plays one SDK stream)
+	myVectorAudioStreamSlot = make(chan struct{}, 1)
 )
 
 // TODO: we should find a way to auto-generate the equivalent of this function as part of clad or protoc
@@ -3604,13 +3608,61 @@ func (service *rpcService) ExternalAudioStreamRequestToGatewayWrapper(request *e
 	return msg, nil
 }
 
-func (service *rpcService) ExternalAudioStreamRequestHandler(in extint.ExternalInterface_ExternalAudioStreamPlaybackServer, done chan struct{}) {
+// my-vector sdk-audio-orphan: a client silent this long after Prepare is dead; its stream ends as an unfinished close
+const myVectorAudioIdleTimeout = 10 * time.Second
+
+type myVectorAudioStream struct {
+	verdict  atomic.Bool // the engine answered this stream (Complete/Overrun/Failure); a Cancel now would hit the next stream
+	timedOut bool        // written before done closes
+}
+
+func (service *rpcService) ExternalAudioStreamRequestHandler(in extint.ExternalInterface_ExternalAudioStreamPlaybackServer, done chan struct{}, st *myVectorAudioStream) {
 	defer close(done)
+	// my-vector sdk-audio-orphan: the slot frees only after the Cancel below, so that Cancel cannot hit the next stream
+	defer func() { <-myVectorAudioStreamSlot }()
+	prepared := false
+	defer func() {
+		if !prepared || st.verdict.Load() {
+			return
+		}
+		log.Println("my-vector.SdkAudioOrphan: stream closed after Prepare without Complete, sending Cancel")
+		cancel := &extint.GatewayWrapper{OneofMessageType: &extint.GatewayWrapper_ExternalAudioStreamCancel{
+			ExternalAudioStreamCancel: &extint.ExternalAudioStreamCancel{},
+		}}
+		if _, _, err := engineProtoManager.Write(cancel); err != nil {
+			log.Printf("Could not write GatewayWrapper_ExternalAudioStreamCancel\n")
+		}
+	}()
+	requests := make(chan *extint.ExternalAudioStreamRequest)
+	recvErr := make(chan error, 1)
+	go func() {
+		for {
+			request, err := in.Recv()
+			if err != nil {
+				recvErr <- err
+				return
+			}
+			select {
+			case requests <- request:
+			case <-done:
+				return
+			}
+		}
+	}()
+	idle := time.NewTimer(myVectorAudioIdleTimeout)
+	idle.Stop()
+	var idleC <-chan time.Time // nil (never fires) unless Prepare was sent and Complete/Cancel not yet
 	for {
-		request, err := in.Recv()
-		if err != nil {
+		var request *extint.ExternalAudioStreamRequest
+		select {
+		case err := <-recvErr:
 			log.Printf("AudioStreamRequestHandler.close: %s\n", err.Error())
 			return
+		case <-idleC:
+			log.Printf("my-vector.SdkAudioOrphan: no request for %s after Prepare, closing the stream\n", myVectorAudioIdleTimeout)
+			st.timedOut = true
+			return
+		case request = <-requests:
 		}
 		log.Println("External AudioStream playback incoming request") //not printing message, lengthy sample data too busy for logs
 
@@ -3619,6 +3671,18 @@ func (service *rpcService) ExternalAudioStreamRequestHandler(in extint.ExternalI
 			log.Println(err)
 			return
 		}
+		switch request.AudioRequestType.(type) {
+		case *extint.ExternalAudioStreamRequest_AudioStreamPrepare:
+			prepared = true
+		case *extint.ExternalAudioStreamRequest_AudioStreamComplete, *extint.ExternalAudioStreamRequest_AudioStreamCancel:
+			prepared = false
+		}
+		idle.Stop()
+		idleC = nil
+		if prepared {
+			idle.Reset(myVectorAudioIdleTimeout)
+			idleC = idle.C
+		}
 
 		numCommandsSentFromSDK++
 		_, _, err = engineProtoManager.Write(msg)
@@ -3628,16 +3692,25 @@ func (service *rpcService) ExternalAudioStreamRequestHandler(in extint.ExternalI
 	}
 }
 
-func (service *rpcService) ExternalAudioStreamResponseHandler(out extint.ExternalInterface_ExternalAudioStreamPlaybackServer, responses chan extint.GatewayWrapper, done chan struct{}) error {
+func (service *rpcService) ExternalAudioStreamResponseHandler(out extint.ExternalInterface_ExternalAudioStreamPlaybackServer, responses chan extint.GatewayWrapper, done chan struct{}, st *myVectorAudioStream) error {
 	for {
 		select {
 		case <-done:
+			if st.timedOut {
+				return grpc.Errorf(codes.DeadlineExceeded, "my-vector.SdkAudioOrphan: no audio request for %s after Prepare", myVectorAudioIdleTimeout)
+			}
 			return nil
 		case response, ok := <-responses:
 			if !ok {
 				return grpc.Errorf(codes.Internal, "Failed to retrieve message")
 			}
 			msg := response.GetExternalAudioStreamResponse()
+			switch msg.GetAudioResponseType().(type) {
+			case *extint.ExternalAudioStreamResponse_AudioStreamPlaybackComplete,
+				*extint.ExternalAudioStreamResponse_AudioStreamBufferOverrun,
+				*extint.ExternalAudioStreamResponse_AudioStreamPlaybackFailyer:
+				st.verdict.Store(true)
+			}
 			if err := out.Send(msg); err != nil {
 				log.Println("Closing AudioStream (on send):", err)
 				return err
@@ -3654,6 +3727,12 @@ func (service *rpcService) ExternalAudioStreamResponseHandler(out extint.Externa
 
 // Stream audio to the robot, stream audio playback status back
 func (service *rpcService) ExternalAudioStreamPlayback(bidirectionalStream extint.ExternalInterface_ExternalAudioStreamPlaybackServer) error {
+	select {
+	case myVectorAudioStreamSlot <- struct{}{}: // released by ExternalAudioStreamRequestHandler
+	default:
+		log.Println("my-vector.SdkAudioOrphan: second audio stream refused, one is open")
+		return grpc.Errorf(codes.ResourceExhausted, "my-vector.SdkAudioOrphan: an audio stream is already open")
+	}
 	audioStartTime := time.Now()
 
 	log.Println("sdk.audiostream_started")
@@ -3668,6 +3747,7 @@ func (service *rpcService) ExternalAudioStreamPlayback(bidirectionalStream extin
 	f, audioStreamStatus := engineProtoManager.CreateChannel(&extint.GatewayWrapper_ExternalAudioStreamResponse{}, 1)
 	defer f()
 
-	go service.ExternalAudioStreamRequestHandler(bidirectionalStream, done)
-	return service.ExternalAudioStreamResponseHandler(bidirectionalStream, audioStreamStatus, done)
+	st := &myVectorAudioStream{}
+	go service.ExternalAudioStreamRequestHandler(bidirectionalStream, done, st)
+	return service.ExternalAudioStreamResponseHandler(bidirectionalStream, audioStreamStatus, done, st)
 }
