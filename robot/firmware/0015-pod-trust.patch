From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kristjan Sillmann <kristjan.h.s@gmail.com>
Date: Sun, 8 Nov 2026 11:00:00 +0200
Subject: [PATCH] pod-trust

vic-cloud stops trusting the DDL escapepod root CA (plan P1/T4): jdocs.newConn no longer appends
escapepodRootPEM to the shared rootcerts.ServerCertPool(), and escapepod_root_cert.go is deleted, so
the pool holds the public roots plus the wire-pod cert main loads (/anki/etc or /data/data
wirepod-cert.crt). Marker my-vector.PodTrust: main logs it at start (journal), and
/anki/etc/vic-cloud.env carries it as a comment, because anki_build_go UPX-packs vic-cloud and a
packed binary's strings are unreadable.
---
 cloud/cloud/main.go                         |  1 +
 cloud/internal/jdocs/client.go              |  3 +-
 cloud/internal/jdocs/escapepod_root_cert.go | 37 ---------------------
 platform/config/etc/vic-cloud.env           |  1 +
 4 files changed, 3 insertions(+), 39 deletions(-)
 delete mode 100644 cloud/internal/jdocs/escapepod_root_cert.go

diff --git a/cloud/cloud/main.go b/cloud/cloud/main.go
index 781b1861..15891f44 100644
--- a/cloud/cloud/main.go
+++ b/cloud/cloud/main.go
@@ -89,6 +89,7 @@ func randomString() string {
 func main() {
 	go mainGateway()
 	var pool = rootcerts.ServerCertPool()
+	log.Println("my-vector.PodTrust: DDL escapepod root not trusted; pod trust = " + podCert + " only")
 	// load custom cert
 	// /anki/etc/wirepod-cert.crt
 	certBytes, err := os.ReadFile(fsroot.RobotPath("/anki/etc/" + podCert))
diff --git a/cloud/internal/jdocs/client.go b/cloud/internal/jdocs/client.go
index cea6d0b4..abf35f8e 100644
--- a/cloud/internal/jdocs/client.go
+++ b/cloud/internal/jdocs/client.go
@@ -25,10 +25,9 @@ type conn struct {
 
 func newConn(ctx context.Context, opts *options) (*conn, error) {
 
+	// my-vector 0015: no DDL escapepod root; the shared pool = public roots + the wire-pod cert main loaded.
 	pool := rootcerts.ServerCertPool()
 
-	_ = pool.AppendCertsFromPEM([]byte(escapepodRootPEM))
-
 	dialOpts := []grpc.DialOption{
 		grpc.WithTransportCredentials(
 			credentials.NewClientTLSFromCert(pool, ""),
diff --git a/cloud/internal/jdocs/escapepod_root_cert.go b/cloud/internal/jdocs/escapepod_root_cert.go
deleted file mode 100644
