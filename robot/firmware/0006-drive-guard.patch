From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kristjan Sillmann <kristjan.h.s@gmail.com>
Date: Wed, 4 Nov 2026 09:17:16 +0200
Subject: [PATCH] drive-guard

vic-engine: on charger contacts DriveStraightAction::Init ignores SetCanMoveOnCharger(true)
and returns SHOULDNT_DRIVE_ON_CHARGER, so BehaviorDriveOffCharger's straight-drive attempts
fail at once instead of timing out against the motor lock. Wiggle-back runs off contacts and
is unaffected. Logs my-vector.DriveGuard.
---
 engine/actions/basicActions.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/engine/actions/basicActions.cpp b/engine/actions/basicActions.cpp
index e52972b1..d1e3b98d 100644
--- a/engine/actions/basicActions.cpp
+++ b/engine/actions/basicActions.cpp
@@ -800,6 +800,11 @@ namespace Anki {
       if(!_canMoveOnCharger && GetRobot().GetBatteryComponent().IsOnChargerPlatform() ) {
         return ActionResult::SHOULDNT_DRIVE_ON_CHARGER;
       }
+      // my-vector drive guard: on contacts, forward drives ignore SetCanMoveOnCharger(true); reverse re-seating still runs
+      if( _dist_mm > 0.f && GetRobot().GetBatteryComponent().IsOnChargerContacts() ) {
+        LOG_INFO("my-vector.DriveGuard", "DriveStraight [%d] refused on charger contacts", GetTag());
+        return ActionResult::SHOULDNT_DRIVE_ON_CHARGER;
+      }
 
       const Radians heading = GetRobot().GetPose().GetRotation().GetAngleAroundZaxis();
       
